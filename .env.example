# 复制成 .env 后按实际情况修改，docker compose 会自动读取。
# 不在 .env 里写也行，直接改 docker-compose.yml 里的默认值。

# ---- 第 1 块额外硬盘 / NAS（素材目录）----
# Windows 已映射成盘符的 NAS：Z:/素材  （注意用正斜杠）
# Windows 本地第二块盘：D:/素材
# Linux / NAS 本机：/volume1/素材
MEDIA_HOST_1=./mnt/media1

# ---- 第 2 块额外硬盘 / NAS（申诉材料）----
MEDIA_HOST_2=./mnt/media2

# 容器内可访问的根目录（和上面 volumes 冒号右边保持一致，多个用冒号分隔）
DS_EXTRA_ROOTS=/mnt/media1:/mnt/media2
